<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/live_super_chat_history_row_gap"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/blbl_focus_scale"
    app:cardBackgroundColor="#55282828"
    app:cardCornerRadius="@dimen/live_super_chat_history_row_radius"
    app:strokeColor="?attr/blblFocusStrokeColor"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/live_super_chat_history_row_padding">

        <TextView
            android:id="@+id/tv_live_super_chat_history_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/live_super_chat_history_meta_text_size" />

        <TextView
            android:id="@+id/tv_live_super_chat_history_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/live_super_chat_history_content_text_size" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
